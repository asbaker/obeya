      "link": null,
      "locked": false,
      "text": "The logo's source. Edit the frames, then run `mise run logo`: logo-small →\nsrc/page/logo.svg and favicon.png; logo-lockup → src/page/logo-lockup.svg\n(About, README); logo-lockup-dark → src/page/logo-lockup-dark.svg\n(README in dark mode). Keep the two lockups the same apart from the text\ncolour.",
      "fontSize": 15,
      "baseFontSize": 15,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "lg-note",
      "originalText": "The logo's source. Edit the frames, then run `mise run logo`: logo-small → src/page/logo.svg and favicon.png; logo-lockup → src/page/logo-lockup.svg (About, README); logo-lockup-dark → src/page/logo-lockup-dark.svg (README in dark mode). Keep the two lockups the same apart from the text colour.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    }
